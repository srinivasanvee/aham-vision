<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#080D0F" android:orientation="vertical"
    android:paddingHorizontal="24dp" android:paddingTop="56dp" android:paddingBottom="24dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/counter_choose_title" android:textColor="#FFFFFFFF"
        android:textSize="28sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:text="@string/counter_choose_description"
        android:textColor="#FFB8C4C2" android:textSize="16sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:text="@string/object_to_count"
        android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" />
    <Spinner android:id="@+id/target" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="8dp" android:background="#FFFFFFFF" android:paddingHorizontal="12dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:text="@string/counter_model_note"
        android:textColor="#FFFFD54F" android:textSize="14sp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/startCounter"
        android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="32dp"
        android:text="@string/start_counting" android:textAllCaps="false" android:textSize="17sp" />
</LinearLayout>
